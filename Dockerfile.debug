FROM rust:1.85-bookworm as build

WORKDIR /code

COPY . /code

# Skip the build step for debugging
# RUN cargo build --release

# Copy the binary into a new container for a smaller docker image
FROM debian:bookworm-slim

# Install LibreOffice for DOCX to PDF conversion and poppler-utils for PDF text extraction
RUN apt-get update && \
    apt-get install -y \
    libreoffice-writer \
    libreoffice-core \
    libreoffice-common \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Copy the source code instead of pre-built binary
COPY --from=build /code /code
WORKDIR /code

# Install Rust for manual building
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && \
    PATH="/root/.cargo/bin:$PATH"

USER root

# Default entrypoint that you can override
ENTRYPOINT ["/bin/bash"]
